{
  "$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!pnpm-lock.yaml"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noLabelWithoutControl": "error",
        "noStaticElementInteractions": "error",
        "noSvgWithoutTitle": "error",
        "useButtonType": "error",
        "useKeyWithClickEvents": "error"
      },
      "correctness": {
        "noUnusedFunctionParameters": "error",
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "useExhaustiveDependencies": "error"
      },
      "style": {
        "noNonNullAssertion": "error",
        "useExponentiationOperator": "error",
        "useImportType": "error",
        "useNodejsImportProtocol": "error",
        "useTemplate": "error"
      },
      "suspicious": {
        "noArrayIndexKey": "error",
        "noCommentText": "error",
        "noExplicitAny": "error",
        "noShadowRestrictedNames": "error",
        "noTemplateCurlyInString": "error",
        "useIterableCallbackReturn": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/analytics/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/curriculum/*",
                      "!**/curriculum/keyboardLayout",
                      "!**/curriculum/keyboardLayout.ts"
                    ],
                    "message": "Analytics imports only the curriculum's key and finger table (keyboardLayout), never the Sectors and Stages (ADR-0004)."
                  },
                  {
                    "group": [
                      "**/game",
                      "**/game/**",
                      "**/app",
                      "**/app/**",
                      "**/screens",
                      "**/screens/**",
                      "**/deck",
                      "**/deck/**",
                      "**/audio",
                      "**/audio/**",
                      "react",
                      "react/**",
                      "react-dom",
                      "react-dom/**",
                      "pixi.js",
                      "pixi.js/**"
                    ],
                    "message": "Analytics imports nothing from the game, React, PixiJS or sound (ADR-0004)."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
