{
  "name": "astrotype",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=26.12.1 <27",
    "pnpm": ">=12.15.0 <13"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "check": "tsc --noEmit && biome check --error-on-warnings && vitest run --passWithNoTests",
    "verify": "node scripts/verify.mjs",
    "fix": "biome check --write",
    "screenshots:update": "node scripts/screenshots.mjs --update",
    "build": "vite build",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^0.546.0",
    "pixi.js": "^8.22.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "xstate": "^5.33.2",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "happy-dom": "21.0.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "5.0.5",
    "wrangler": "4.152.0"
  }
}
